""")


# ЗАПУСК

print("=" * 40)
print("       ЛАБИРИНТ СОКРОВИЩ")
print("=" * 40)

print("Ваша задача — найти ключ и выйти из лабиринта.")
print("Начальная позиция:", (player_x, player_y))

# Отмечаем стартовую комнату
enter_room()

help_menu()

while not game_over:

    show_status()

    command = input("Введите команду: ").lower().strip()

    if command in ["w", "a", "s", "d"]:
        move(command)

    elif command == "i":
        show_inventory()

    elif command == "m":
        show_map()

    elif command == "u":
        use_item()

    elif command == "b":
        drop_item()

    elif command == "p":
        drop_last_item()

    elif command == "t":
        sort_inventory()

    elif command == "c":
        copy_inventory()

    elif command == "e":
        upgrade_sword()

    elif command == "h":
        help_menu()

    elif command == "q":
        print("Вы вышли из игры.")
        break

    else:
        print("Неизвестная команда.")

print("\nИГРА ЗАВЕРШЕНА")
print("Посещено комнат:", len(visited_rooms))
print("Всего комнат:", len(rooms))
