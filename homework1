import math
from typing import Union, Optional

# Уровень 2: 4 функции для арифметических операций
def add(x: float, y: float) -> float:
    return x + y

def subtract(x: float, y: float) -> float:
    return x - y

def multiply(x: float, y: float) -> float:
    return x * y

def divide(x: float, y: float):
    if y == 0:
        return None
    return x / y

# Уровень 3: 1 функция для всех арифметических операций
def calculate_arithmetic(a: float, b: float, operation: int):
    if operation == 1:
        return a + b
    elif operation == 2:
        return a - b
    elif operation == 3:
        return a * b
    elif operation == 4:
        if b == 0:
            return None
        return a / b
    else:
        return None

# Уровень 4: класс Calculator с аннотацией типов
class Calculator:
    def arithmetic(self, a: float, b: float, operation: int):
        if operation == 1:
            return a + b
        elif operation == 2:
            return a - b
        elif operation == 3:
            return a * b
        elif operation == 4:
            if b == 0:
                return None
            return a / b
        else:
            return None
    
    def trigonometric(self, angle: float, operation: int):
        if operation == 5:
            return math.sin(angle)
        elif operation == 6:
            return math.cos(angle)
        elif operation == 7:
            return math.tan(angle)
        else:
            return None

